{
  "name": "fulfillment-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:landscape-sizes": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/add-landscape-sizes.ts",
    "seed:square-panoramic-sizes": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/add-square-panoramic-sizes.ts",
    "seed:reconcile-template-options": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/reconcile-template-options.ts",
    "seed:inspect-size-options": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/inspect-size-options.ts",
    "seed:import-sizes-csv": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/import-sizes-from-csv.ts"
  },
  "dependencies": {
    "@artbox/types": "workspace:*",
    "@artbox/ui": "workspace:*",
    "@payloadcms/db-postgres": "latest",
    "@payloadcms/next": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "@payloadcms/ui": "latest",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "~15.4.11",
    "payload": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
